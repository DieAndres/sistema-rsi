POSTGRES_DB=rsi
POSTGRES_USER=rsi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rsi:change-me@localhost:5432/rsi
WEBAUTHN_ORIGIN=http://localhost:5173

