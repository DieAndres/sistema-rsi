POSTGRES_DB=rsi
POSTGRES_USER=rsi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rsi:change-me@localhost:5432/rsi

# Docker: public frontend URL.
PUBLIC_ORIGIN=https://localhost:8443
SESSION_ALLOWED_ORIGINS=https://localhost:8443,http://localhost:5173
FRONTEND_PORT=8080
FRONTEND_HTTPS_PORT=8443
FRONTEND_BIND_ADDRESS=127.0.0.1
TLS_CERT_DIRECTORY=./infrastructure/nginx/certs


# Definir en backend/.env: clave aleatoria de 32 bytes en hexadecimal.
# No guardar la clave real en el repositorio.
TOTP_ENCRYPTION_KEY=
