PUBLIC_ORIGIN=https://localhost:8443
FRONTEND_PORT=8080
FRONTEND_HTTPS_PORT=8443
FRONTEND_BIND_ADDRESS=127.0.0.1
TLS_CERT_DIRECTORY=./infrastructure/nginx/certs

